# syntax = docker/dockerfile:1

# The standalone @pace/api server (Nitro node-server preset). Mirrors the web
# Dockerfile; the API was never shipped in Phase 1 (prod was web-only), so this
# is what makes a full deployable stack — the foundation for staging + previews.

# ---- base: Node 24 + pnpm via Corepack ----
FROM node:24-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH="/pnpm:$PATH"
RUN corepack enable
WORKDIR /app

# ---- deps: install the @pace/api subtree from the frozen lockfile ----
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/validation/package.json ./packages/validation/
COPY packages/tsconfig/package.json ./packages/tsconfig/
# `@pace/api...` pulls its workspace deps (@pace/validation, @pace/tsconfig) too.
RUN pnpm install --frozen-lockfile --filter @pace/api...

# ---- build: produces the Nitro node-server output ----
FROM deps AS build
COPY . .
RUN pnpm --filter @pace/api build

# ---- migrate: one-off image that applies drizzle migrations, then exits ----
# Reuses the build stage (dev deps + drizzle/ + config). deploy/bin/up.sh runs
# this against each environment's database before the API serves traffic.
# drizzle.config.ts reads DATABASE_URL straight from the env, so pass it with -e.
FROM build AS migrate
CMD ["pnpm", "--filter", "@pace/api", "db:migrate"]

# ---- seed: one-off image that seeds a known-password test user, then exits ----
# Reuses the build stage (dev deps incl. tsx + the source). deploy/bin/up.sh runs
# this after migrate, for NON-prod envs only — idempotent, so re-runs are no-ops.
FROM build AS seed
CMD ["pnpm", "--filter", "@pace/api", "db:seed"]

# ---- runtime: slim image with only the built server ----
FROM node:24-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
COPY --from=build --chown=node:node /app/apps/api/.output ./.output
EXPOSE 3001
USER node
CMD ["node", ".output/server/index.mjs"]
