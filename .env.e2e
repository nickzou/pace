# Backend env for LOCAL mobile e2e (scripts/local-mobile-e2e.sh) — the pace_test stack, not
# your dev DB. Sourced and handed to the PRODUCTION api server (`build && start`), which
# ignores the repo .env, so these win cleanly (unlike `nitro dev`, which auto-loads .env and
# clobbers them). No secrets here — same throwaway values CI's mobile-e2e uses.
DATABASE_URL=postgresql://pace:pace@localhost:5433/pace_test
BETTER_AUTH_SECRET=ci-mobile-secret-not-used-in-prod
BETTER_AUTH_URL=http://localhost:3001
# The emulator reaches host services via 10.0.2.2; baked into the APK at build time.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
EXPO_PUBLIC_POWERSYNC_URL=http://10.0.2.2:8180
# Permit cleartext http in the debug APK (local/CI only — see app.config.ts).
PACE_ALLOW_CLEARTEXT=1
# PowerSync (in the compose) points its JWKS at the api on this port.
API_PORT=3001
