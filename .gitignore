# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Nitro (apps/api) build + generated types
.output/
.nitro/

# Turborepo
.turbo/

# Playwright (e2e)
e2e/playwright/.auth/
e2e/playwright-report/
e2e/test-results/
e2e/blob-report/

# Tauri (Rust) build artifacts
target/

# Env / secrets
.env
.env.*
!.env.example
# Non-secret e2e backend config (throwaway values; used by scripts/local-mobile-e2e.sh)
!.env.e2e

# TLS certs / keys — provisioned onto the box from secrets, never committed
*.pem
*.key
deploy/certs/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/

# Generated per-environment deploy files (hold secrets)
deploy/envs/

# Local mobile e2e build artifact (scripts/local-mobile-e2e.sh)
pace-app.apk
