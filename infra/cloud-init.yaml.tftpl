#cloud-config

users:
  - name: deploy
    shell : /bin/bash
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      %{ for key in ssh_public_keys ~}
        - ${key}
      %{ endfor ~}

runcmd:
  - curl -fsSL https://get.docker.com | sh
  - usermod -aG docker deploy
  - systemctl enable --now docker

ssh_pwauth: false
