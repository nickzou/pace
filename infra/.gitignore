# OpenTofu / Terraform

# Local provider cache + downloaded plugins (regenerated by `tofu init`)
.terraform/

# State files — hold resource details and can contain secrets. Never commit.
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Note: .terraform.lock.hcl is intentionally NOT ignored — commit it so
# provider versions are pinned (like pnpm-lock.yaml for npm packages).
