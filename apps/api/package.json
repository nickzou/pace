{
  "name": "@pace/api",
  "private": true,
  "type": "module",
  "exports": {
    "./router": "./src/trpc/router.ts"
  },
  "scripts": {
    "dev": "nitro dev --port 3001",
    "build": "nitro build",
    "prepare": "nitro prepare",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "auth:generate": "better-auth generate --config src/auth.ts --output src/db/auth.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/expo": "1.4.22",
    "@pace/validation": "workspace:*",
    "@trpc/server": "^11.18.0",
    "better-auth": "1.4.22",
    "drizzle-orm": "^0.44.0",
    "nitro": "3.0.260610-beta",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.22",
    "@pace/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
