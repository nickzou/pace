# Copy to .env.local (gitignored) and set for on-device runs.
#
# Which API origin the app authenticates against. On a real device, localhost
# is the phone itself — use your dev machine's LAN IP so the phone can reach the
# API (find it with `ip addr` / `ifconfig`), or point at the deployed API.
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# The self-hosted PowerSync service the app syncs through (docker-compose.yml,
# :8080). Same LAN-IP rule as the API on a real device; Android emulator uses
# http://10.0.2.2:8080.
#   EXPO_PUBLIC_POWERSYNC_URL=http://192.168.1.20:8080
EXPO_PUBLIC_POWERSYNC_URL=http://localhost:8080
