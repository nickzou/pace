    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.25",
