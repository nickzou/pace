# Local Postgres (docker-compose.yml). Copy to .env and adjust for your machine.
POSTGRES_USER=pace
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pace

# Connection string for the API / drizzle-kit (matches the values above).
DATABASE_URL=postgresql://pace:change_me@localhost:5432/pace

# Better Auth (apps/api). Generate a secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change_me
BETTER_AUTH_URL=http://localhost:3001

# Comma-separated origins allowed to call the auth API (CORS + CSRF check).
# Includes the packaged desktop app's origins: Tauri serves the built app from
# tauri://localhost (Linux/macOS) / http://tauri.localhost (Windows).
TRUSTED_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost

# Web app (apps/web) → which API origin the browser talks to. VITE_-prefixed,
# so it's inlined into the client bundle (never put secrets here).
VITE_API_URL=http://localhost:3001

# Web app → the self-hosted PowerSync service it syncs local SQLite through
# (docker-compose.yml, published on :8080). Also VITE_-prefixed / inlined.
VITE_POWERSYNC_URL=http://localhost:8080

# --- Email verification (apps/api) ---
# Gate new accounts behind email verification. Off by default so it ships dark;
# turn on per-environment ONLY AFTER migration 0012 has backfilled existing users
# (else everyone is locked out). Set to true to test the flow locally.
REQUIRE_EMAIL_VERIFICATION=false

# Public web origin — verification links always point here (never tauri:// or the
# mobile scheme), so one link works from web, desktop, and mobile.
WEB_URL=http://localhost:3000

# Transactional email over SMTP (nodemailer). Dev/CI point at Mailpit
# (docker-compose.yml → SMTP :1025, inbox UI http://localhost:8025, no auth). Prod
# points at Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend,
# SMTP_PASS=<your Resend API key>. Same code path everywhere — only these change.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=Pace <no-reply@pace.local>
