# Every variable a per-env stack needs. This is DOCUMENTATION — the real files
# are generated per environment by deploy/bin/render-env.sh into deploy/envs/
# (gitignored; they hold secrets). Values below show the shape for "pr-101".

# --- identity (all derived from the env name) ---
ENV_NAME=pr-101
STACK=pace-pr-101                 # compose project + Traefik label namespace
HOST=pr-101.paceproductivity.app  # the one hostname this env is served at
COMPOSE_PROJECT_NAME=pace-pr-101

# --- images (the SAME images across every env; only tags vary) ---
IMAGE_WEB=ghcr.io/nickzou/pace/web:<sha>
IMAGE_API=ghcr.io/nickzou/pace/api:<sha>
POWERSYNC_IMAGE=journeyapps/powersync-service:1.23.3

# --- shared Postgres (deploy/platform) — a database per env on one server ---
POSTGRES_USER=pace
POSTGRES_PASSWORD=<secret>
DB_NAME=pace_pr_101               # this env's app database
STORAGE_DB_NAME=powersync_pr_101  # this env's PowerSync bucket-storage database
DATABASE_URL=postgresql://pace:<secret>@pace-postgres:5432/pace_pr_101

# --- auth (per env) ---
BETTER_AUTH_SECRET=<secret>       # shared secret is fine for throwaway previews
BETTER_AUTH_URL=https://pr-101.paceproductivity.app
TRUSTED_ORIGINS=https://pr-101.paceproductivity.app,tauri://localhost,http://tauri.localhost

# --- browser-facing URLs injected into web at runtime (getConfig / __PACE_CONFIG__) ---
API_URL=https://pr-101.paceproductivity.app
POWERSYNC_URL=https://pr-101.paceproductivity.app/powersync

# --- PowerSync service ---
PS_DATA_SOURCE_URI=postgresql://pace:<secret>@pace-postgres:5432/pace_pr_101
PS_STORAGE_SOURCE_URI=postgresql://pace:<secret>@pace-postgres:5432/powersync_pr_101
PS_JWKS_URL=http://pace-pr-101-api:3001/api/auth/jwks  # this env's API, by alias
PS_PORT=8080
