# Every variable a per-env stack needs. This is DOCUMENTATION — the real files
# are generated per environment by deploy/bin/render-env.sh into deploy/envs/
# (gitignored; they hold secrets). Values below show the shape for "pr-101".
#
# Each env runs its OWN Postgres, so DB hosts are the in-stack service names and
# the DB names are fixed (isolation is the separate container + volume).

# --- identity (all derived from the env name) ---
ENV_NAME=pr-101
STACK=pace-pr-101                 # compose project + Traefik label namespace
HOST=pr-101.paceproductivity.app  # the one hostname this env is served at
COMPOSE_PROJECT_NAME=pace-pr-101

# --- images (the SAME images across every env; only tags vary) ---
IMAGE_WEB=ghcr.io/nickzou/pace/web:<sha>
IMAGE_API=ghcr.io/nickzou/pace/api:<sha>
IMAGE_API_MIGRATE=ghcr.io/nickzou/pace/api-migrate:<sha>
IMAGE_API_SEED=ghcr.io/nickzou/pace/api-seed:<sha>  # seeds a test user (non-prod only)
POWERSYNC_IMAGE=journeyapps/powersync-service:1.23.3
POSTGRES_IMAGE=postgres:17-alpine

# --- this env's Postgres (a container in the stack, on its private network) ---
POSTGRES_USER=pace
POSTGRES_PASSWORD=<secret>
DATABASE_URL=postgresql://pace:<secret>@postgres:5432/pace

# --- auth (per env) ---
BETTER_AUTH_SECRET=<secret>       # shared secret is fine for throwaway previews
BETTER_AUTH_URL=https://pr-101.paceproductivity.app
TRUSTED_ORIGINS=https://pr-101.paceproductivity.app,tauri://localhost,http://tauri.localhost

# --- browser-facing URLs injected into web at runtime (getConfig / __PACE_CONFIG__) ---
API_URL=https://pr-101.paceproductivity.app
POWERSYNC_URL=https://pr-101.paceproductivity.app/powersync

# --- email verification (per env; rendered by render-env.sh) ---
# Prod is the only env that gates + sends: REQUIRE_EMAIL_VERIFICATION=true with SMTP
# pointed at Resend (SMTP_PASS = the PROD_RESEND_API_KEY secret). Every other env is
# gate-off with empty SMTP — sign-up sends no mail. WEB_URL is the public origin all
# verification links point at, so one link works from web/desktop/mobile.
REQUIRE_EMAIL_VERIFICATION=false        # prod: true
WEB_URL=https://pr-101.paceproductivity.app
EMAIL_FROM=Pace <no-reply@paceproductivity.app>
SMTP_HOST=                              # prod: smtp.resend.com
SMTP_PORT=                              # prod: 587
SMTP_USER=                              # prod: resend
SMTP_PASS=<secret>                     # prod: the Resend API key

# --- PowerSync service ---
PS_DATA_SOURCE_URI=postgresql://pace:<secret>@postgres:5432/pace
PS_STORAGE_SOURCE_URI=postgresql://pace:<secret>@powersync-storage:5432/powersync
PS_JWKS_URL=http://pace-pr-101-api:3001/api/auth/jwks  # this env's API, unique alias
PS_PORT=8080
