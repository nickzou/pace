{
  "extends": "@pace/tsconfig/base.json",
  "compilerOptions": {
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework"],
    // DOM for the browser-context code inside browser.execute() callbacks.
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["**/*.ts"]
}
