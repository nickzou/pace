{
  "name": "pace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @pace/api dev",
    "dev:web": "pnpm --filter @pace/web dev",
    "dev:desktop": "pnpm --filter @pace/web exec cargo tauri dev",
    "dev:mobile": "pnpm --filter @pace/mobile start",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test --filter=@pace/api --filter=@pace/validation --filter=@pace/web --filter=@pace/mobile",
    "check": "biome check . && turbo typecheck && turbo test --filter=@pace/api --filter=@pace/validation --filter=@pace/web --filter=@pace/mobile",
    "format": "biome check --write .",
    "lint:actions": "actionlint",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "turbo": "^2.10.7"
  }
}
